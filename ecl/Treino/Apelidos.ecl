// Tabela de referencia: apelido -> nome formal (tudo em maiusculas).
EXPORT Apelidos := DATASET([
  {'JIM', 'JAMES'}, {'BOB', 'ROBERT'}, {'JOHNNY', 'JOHN'}, {'MIKE', 'MICHAEL'}, {'BILL', 'WILLIAM'},
  {'DAVE', 'DAVID'}, {'RICK', 'RICHARD'}, {'JOE', 'JOSEPH'}, {'TOM', 'THOMAS'}, {'CHUCK', 'CHARLES'},
  {'PAT', 'PATRICIA'}, {'JEN', 'JENNIFER'}, {'LIZ', 'ELIZABETH'}, {'BARB', 'BARBARA'}, {'SUE', 'SUSAN'},
  {'JESS', 'JESSICA'}, {'DAN', 'DANIEL'}, {'MATT', 'MATTHEW'}, {'TONY', 'ANTHONY'}, {'MAGGIE', 'MARGARET'},
  {'KATE', 'KATHERINE'}, {'CHRIS', 'CHRISTOPHER'}, {'STEVE', 'STEVEN'}, {'ANDY', 'ANDREW'}, {'DEBBIE', 'DEBORAH'}
], {STRING20 apelido, STRING20 nome});
